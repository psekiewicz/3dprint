# Skopiuj ten plik jako .env i uzupełnij. Pliku .env NIE wrzucaj do repozytorium.

# Adres, pod którym działa strona (trafia do linków w mailach).
PUBLIC_URL=https://druk.pixelinventor.com

# Skrzynka, z której wychodzą maile do kupujących (dane znajdziesz w panelu OVH).
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_USER=contact@pixelinventor.com
SMTP_PASS=tu-wpisz-haslo-do-skrzynki
MAIL_FROM=Druk 3D <contact@pixelinventor.com>

# Opcjonalnie: gdy wysyłasz z noreply@, a odpowiedzi mają trafiać gdzie indziej.
# MAIL_REPLY_TO=contact@pixelinventor.com
